<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <!-- Photo Collector header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_sm">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/photo_collector"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_photo"
                    style="@style/ISeeGrass.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_image"
                    app:icon="@drawable/ic_add"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Photo hint -->
            <TextView
                android:id="@+id/tv_photo_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/photo_collector_hint"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <!-- Photo grid RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_photos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="@dimen/spacing_md" />

            <!-- Bulk delete for photos (shown in selection mode) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_bulk_delete_photos"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/bulk_delete"
                android:textColor="@color/error"
                app:strokeColor="@color/error"
                android:visibility="gone"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <!-- Identify button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_identify"
                style="@style/ISeeGrass.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/identify_75"
                android:layout_marginBottom="@dimen/spacing_md" />

            <!-- Progress for identify -->
            <ProgressBar
                android:id="@+id/progress_identify"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:visibility="gone"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <!-- Result card (hidden until identify returns) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_result"
                style="@style/ISeeGrass.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:id="@+id/tv_result_species"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tv_result_confidence"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/accent"
                        android:textSize="14sp"
                        android:layout_marginBottom="@dimen/spacing_sm" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_scores"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ID History section header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_marginBottom="@dimen/spacing_sm">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/id_history"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Bulk delete history -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_bulk_delete_history"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bulk_delete"
                    android:textColor="@color/error"
                    app:strokeColor="@color/error"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <!-- Toggle show/hide history -->
                <ImageButton
                    android:id="@+id/btn_toggle_history"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_chevron_down"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/id_history"
                    android:tint="@color/text_muted"
                    android:layout_marginStart="@dimen/spacing_sm" />

            </LinearLayout>

            <!-- Retry connection lost -->
            <LinearLayout
                android:id="@+id/layout_history_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="@dimen/spacing_sm">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/network_error"
                    android:textColor="@color/error"
                    android:textSize="13sp" />

                <ImageButton
                    android:id="@+id/btn_retry_history"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_retry"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/retry"
                    android:tint="@color/accent" />

            </LinearLayout>

            <!-- History list (collapsible) -->
            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipe_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
