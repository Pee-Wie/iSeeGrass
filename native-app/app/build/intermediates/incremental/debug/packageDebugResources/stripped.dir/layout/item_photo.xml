<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/photo_grid_item_size"
    android:layout_height="@dimen/photo_grid_item_size"
    android:layout_margin="2dp">

    <!-- Photo image -->
    <ImageView
        android:id="@+id/iv_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="@color/surface"
        android:contentDescription="@string/add_image" />

    <!-- Selection overlay (shown in selection mode) -->
    <View
        android:id="@+id/view_selected_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#668ED655"
        android:visibility="gone" />

    <!-- Checkbox top-left (shown in selection mode) -->
    <CheckBox
        android:id="@+id/cb_select"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="4dp"
        android:visibility="gone"
        android:buttonTint="@color/accent"
        android:background="@android:color/transparent" />

</FrameLayout>
