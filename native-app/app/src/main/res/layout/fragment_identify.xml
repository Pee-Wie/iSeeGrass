<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_green_bg">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_result"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardBackgroundColor="#3A3A3A"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Result"
                    android:textColor="@color/off_white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_reset_result"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Reset result"
                    android:src="@drawable/ic_reset"
                    app:tint="@color/off_white" />

                <ImageButton
                    android:id="@+id/btn_flag_result"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Flag wrong prediction"
                    android:src="@drawable/ic_flag"
                    app:tint="@color/off_white" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress_identify"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_result_placeholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No result yet — add a photo and tap Identify"
                android:textColor="#66F5F5F5"
                android:textSize="12sp"
                android:visibility="visible" />

            <TextView
                android:id="@+id/tv_result_scientific"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/light_green_accent"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_manual_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#CC1E4822"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="Manual key identification — no model confidence"
                android:textColor="@color/light_green_accent"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_result_common"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/off_white"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_result_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:textColor="#CCF5F5F5"
                android:textSize="12sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_manual_identify"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:enabled="false"
                android:text="Use manual identification key"
                android:textColor="@color/black"
                app:backgroundTint="@color/light_green_accent"
                app:cornerRadius="8dp" />

            <TextView
                android:id="@+id/tv_offline_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#CC7B1FA2"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="⚡ Offline result — will sync when connected"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/bar_offline_sync"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#CC4A148C"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_result">

        <TextView
            android:id="@+id/tv_pending_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚡ 1 offline result pending sync"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sync_now"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:backgroundTint="#7B1FA2"
            android:text="Sync now"
            android:textColor="@color/white"
            android:textSize="11sp"
            app:cornerRadius="6dp" />
    </LinearLayout>

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/photo_area_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="card_result,bar_offline_sync" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_photos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/dark_green_bg"
        app:layout_constraintBottom_toTopOf="@id/til_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/photo_area_top" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_title"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:hint="Title (recommended for better assessment tracking)"
        app:layout_constraintBottom_toTopOf="@id/bar_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLength="120"
            android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:id="@+id/bar_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/dark_green_surface"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btn_add_photo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/light_green_accent"
            android:text="Add Photo"
            android:textColor="@color/black" />

        <Button
            android:id="@+id/btn_identify"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/send_to_identify" />

        <Button
            android:id="@+id/btn_clear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Clear" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/history_drawer"
        android:layout_width="300dp"
        android:layout_height="0dp"
        android:elevation="12dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/til_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/photo_area_top">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:background="@android:color/transparent">

            <ImageButton
                android:id="@+id/btn_history_toggle"
                android:layout_width="32dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_history_toggle_handle"
                android:contentDescription="Open identification history"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="2dp"
                android:rotation="180"
                android:scaleType="centerInside"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/off_white" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="264dp"
            android:layout_height="match_parent"
            android:background="@color/dark_green_surface"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ID History"
                    android:textColor="@color/off_white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_bulk_delete_history"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="#C62828"
                    android:text="Delete all"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    app:cornerRadius="6dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_history_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="6dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_history_error"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Failed to load history"
                    android:textColor="@color/off_white"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_retry_history"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="@string/retry"
                    android:textSize="11sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_history_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="12dp"
                android:text="No identification history yet"
                android:textColor="@color/off_white"
                android:textSize="12sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_history"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="8dp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
