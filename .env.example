# ─────────────────────────────────────────────
# iSeeGrass — Environment Configuration Template
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────

# ── Application ──────────────────────────────
APP_NAME=iSeeGrass
APP_ENV=production
APP_URL=https://your-domain.com

# ── Database ─────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=your_db_password

# ── Session ──────────────────────────────────
SESSION_COOKIE_NAME=iseegsess
SESSION_LIFETIME_DAYS=7
SESSION_SECURE=true

# ── CNN / Colab API ───────────────────────────
# Update CNN_API_URL every time you start a new Colab/ngrok session.
# Copy the ngrok URL printed in the Colab output (no trailing slash).
# Example: https://abcd-12-34-56-78.ngrok-free.app
CNN_API_URL=https://your-ngrok-url.ngrok-free.app

# Temp dir for image uploads before forwarding to Colab.
# Local XAMPP:  /tmp/iseegrass_uploads
# Railway/Linux: /tmp
CNN_TEMP_DIR=/tmp/iseegrass_uploads
