# ─────────────────────────────────────────────
# iSeeGrass — Environment Configuration
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────

# ── Application ──────────────────────────────
APP_NAME=iSeeGrass
APP_ENV=development
APP_URL=http://localhost:3000

# ── Database ─────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=iseegrass
DB_USER=root
DB_PASS=

# ── Session ──────────────────────────────────
SESSION_COOKIE_NAME=iseegsess
SESSION_LIFETIME_DAYS=7
SESSION_SECURE=false

# ── CNN / Python Bridge ───────────────────────
CNN_PYTHON_BIN=/home/codex/ml_env/bin/python
CNN_SCRIPT_PATH=/media/codex/Shared/iSeeGrass_CNN/predict_api.py
CNN_MODEL_PATH=/media/codex/Shared/iSeeGrass_CNN/CREYNet_v0.02.keras
CNN_TEMP_DIR=/tmp/iseegrass_uploads
